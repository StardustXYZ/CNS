{
  "name": "cns-firebase",
  "private": true,
  "description": "Regole di accesso di Firestore per CNS e i loro test con l'emulatore",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-cns \"node --test test/*.test.mjs\"",
    "emulatori": "firebase emulators:start --only auth,firestore --project demo-cns"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.2"
  }
}
